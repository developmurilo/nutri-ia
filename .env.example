# ==========================================
# VARIÁVEIS DE AMBIENTE - NUTRIIA
# Configure estas variáveis no Vercel (Project Settings > Environment Variables)
# ==========================================

# Google Gemini API Key
GEMINI_API_KEY="sua_chave_gemini_aqui"

# OpenRouter (Opcional - caso queira como fallback)
OPENROUTER_API_KEY=""

# Segredo JWT para geração de tokens de sessão
JWT_SECRET="nutriia_secret_producao_super_seguro_troque_aqui"

# URL do Banco de Dados Supabase (PostgreSQL)
# Copie em: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Exemplo:
# DATABASE_URL="postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=""

# ==========================================
# RECUPERAÇÃO DE SENHA POR E-MAIL (SMTP)
# ==========================================
# Exemplos: Gmail (smtp.gmail.com + senha de app), Brevo (smtp-relay.brevo.com), Resend (smtp.resend.com)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="NutriIA <no-reply@seudominio.com>"
# URL pública do app usada no link do e-mail (ex: https://nutriia.vercel.app), sem barra no final
APP_BASE_URL=""

# ==========================================
# IA - AJUSTES DE DESEMPENHO (opcionais)
# ==========================================
# Modelos separados por vírgula, em ordem de prioridade
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite"
# Timeout por tentativa e prazo total por requisição, em segundos
# IA_TIMEOUT_TENTATIVA="20"
# IA_PRAZO_TOTAL="45"
