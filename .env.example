# ==========================================
# VARIÁVEIS DE AMBIENTE - NUTRIIA
# Configure estas variáveis no Vercel (Project Settings > Environment Variables)
# ==========================================

# Google Gemini API Key
GEMINI_API_KEY="sua_chave_gemini_aqui"

# OpenRouter (Opcional - caso queira como fallback)
OPENROUTER_API_KEY=""

# Segredo JWT para geração de tokens de sessão
JWT_SECRET="nutriia_secret_producao_super_seguro_troque_aqui"

# URL do Banco de Dados Supabase (PostgreSQL)
# Copie em: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Exemplo:
# DATABASE_URL="postgresql://postgres.seuid:suasenha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL=""
